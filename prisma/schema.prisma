generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  STAFF
}

enum CourtType {
  INDOOR
  OUTDOOR
}

enum CourtStatus {
  AVAILABLE
  MAINTENANCE
  INACTIVE
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OpenPlayStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum ParticipantStatus {
  JOINED
  CANCELLED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PROFESSIONAL
}

model User {
  id                    String                @id @default(cuid())
  email                 String                @unique
  passwordHash          String
  firstName             String
  lastName              String
  phone                 String?
  role                  Role                  @default(USER)
  skillLevel            SkillLevel            @default(BEGINNER)
  profileImage          String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  reservations          Reservation[]
  openPlayParticipants  OpenPlayParticipant[]
  notifications         Notification[]
}

model Court {
  id               String            @id @default(cuid())
  name             String
  courtNumber      Int               @unique
  type             CourtType
  surface          String
  description      String
  amenities        String[]
  imageUrl         String
  status           CourtStatus       @default(AVAILABLE)
  openTime         String            @default("08:00")
  closeTime        String            @default("22:00")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  reservations     Reservation[]
  openPlaySessions OpenPlaySession[]
}

model Reservation {
  id                 String            @id @default(cuid())
  userId             String
  courtId            String
  date               DateTime
  startTime          DateTime
  endTime            DateTime
  status             ReservationStatus @default(CONFIRMED)
  cancelledAt        DateTime?
  cancellationReason String?
  paymentStatus      PaymentStatus     @default(NOT_REQUIRED)
  paymentMethod      String?
  paymentReference   String?
  paymentAmount      Decimal?          @db.Decimal(10, 2)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  court              Court             @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([courtId, startTime, endTime, status])
  @@index([userId, startTime])
}

model OpenPlaySession {
  id           String                @id @default(cuid())
  name         String
  courtId      String
  date         DateTime
  startTime    DateTime
  endTime      DateTime
  skillLevel   SkillLevel
  maxPlayers   Int
  status       OpenPlayStatus        @default(SCHEDULED)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  court        Court                 @relation(fields: [courtId], references: [id], onDelete: Cascade)
  participants OpenPlayParticipant[]

  @@index([date, status])
}

model OpenPlayParticipant {
  id        String            @id @default(cuid())
  userId    String
  sessionId String
  status    ParticipantStatus @default(JOINED)
  joinedAt  DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   OpenPlaySession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
